# Copy to .env and fill in. Never commit real values.

# Database. Local SQLite file (relative paths resolve from prisma/). For production use a
# persistent volume, or switch the Prisma provider to PostgreSQL and use its connection string.
DATABASE_URL="file:./dev.db"

# REQUIRED. Long random string (32+ chars) that signs session cookies. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Where uploaded drill videos are stored. Defaults to ./uploads. Point at a persistent disk in production.
# UPLOAD_DIR="/var/data/uploads"

# Public URL of the site, used for canonical links, sitemap.xml and social cards.
SITE_URL="https://pitchpath.example.com"

# Optional: email for "Forgot password?" links (https://resend.com). Without these, the
# forgot-password page tells people to ask their club director to reset their password.
# EMAIL_FROM must use a domain you've verified in Resend.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="PitchPath <noreply@pitchpathsoccer.com>"

# One-click demo logins on the sign-in page. MUST be "false" for a real launch.
DEMO_MODE="false"
